<?xml version="1.0" encoding="UTF-8"?>
<package version="3.0" unique-identifier="id" xmlns="http://www.idpf.org/2007/opf">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="id">lumos-fixed-layout-test</dc:identifier>
    <dc:title>固定版式测试</dc:title>
    <meta property="rendition:layout">pre-paginated</meta>
  </metadata>
  <manifest>
    <item id="page1" href="page.xhtml" media-type="application/xhtml+xml" />
    <item id="page2" href="page2.xhtml" media-type="application/xhtml+xml" />
    <item id="page3" href="page3.xhtml" media-type="application/xhtml+xml" />
    <item id="page4" href="page4.xhtml" media-type="application/xhtml+xml" />
  </manifest>
  <spine page-progression-direction="rtl">
    <itemref idref="page1" properties="page-spread-right" />
    <itemref idref="page2" properties="page-spread-left" />
    <itemref idref="page3" properties="page-spread-right" />
    <itemref idref="page4" properties="page-spread-left" />
  </spine>
</package>
