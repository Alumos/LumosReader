<resources>
    <style name="Widget.Lumos.Button">
        <item name="android:background">@drawable/lumos_button</item>
        <item name="android:textColor">@color/lumos_surface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Lumos.Input">
        <item name="android:background">@drawable/lumos_input</item>
        <item name="android:textColor">@color/lumos_ink</item>
        <item name="android:textColorHint">@color/lumos_ink_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
