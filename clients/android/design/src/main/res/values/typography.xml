        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Lumos.Body" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/lumos_ink_secondary</item>
